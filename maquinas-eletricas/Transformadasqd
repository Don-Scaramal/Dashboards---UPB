n-bottom:8px}.panel-title>div{display:flex;align-items:center;gap:11px}.panel-title .eyebrow{margin-bottom:3px;font-size:9px}.panel-title h3{font-size:15px;margin:0}.step{width:31px;height:31px;border-radius:10px;display:grid;place-items:center;background:#1b3448;color:var(--cyan);font:500 11px 'DM Mono'}.chart{height:280px;width:100%}.metrics{display:grid;gap:8px;margin-top:4px}.metrics.three{grid-template-columns:repeat(3,1fr)}.metrics>div{background:#0c1726;border:1px solid #24364b;border-radius:9px;padding:10px 12px}.metrics strong{font:500 13px 'DM Mono',monospace;color:var(--text)}.equation{background:#0c1726;border:1px solid #25394e;border-radius:10px;padding:15px;margin:13px 0;display:flex;align-items:center;justify-content:space-around;gap:12px;flex-wrap:wrap}.eq-label{font:13px 'DM Mono',monospace;color:#d9e8f6}.matrix{display:flex;align-items:center;gap:7px;color:var(--cyan);font:12px 'DM Mono',monospace;line-height:1.8}.bracket{border-left:1px solid #7691a8;border-right:1px solid #7691a8;padding:2px 9px}.calculation{display:grid;grid-template-columns:1fr 28px 1fr;align-items:center;gap:8px;text-align:center;padding:6px 0}.calculation strong{font:11px 'DM Mono';color:#dce9f6}.calc-arrow{color:var(--cyan);font-size:20px}.compact-eq{padding:12px}.compact-eq .eq-label{font-size:11px}.inverse-grid{display:grid;grid-template-columns:1fr 1fr .8fr;gap:12px}.inverse-equation,.error-box{background:#0c1726;border:1px solid #263a50;border-radius:11px;padding:15px}.inverse-equation .eyebrow{margin-bottom:12px}.inverse-equation .eq-label{font-size:12px;margin:8px 0}.inverse-equation small{display:block;color:var(--cyan);font:11px 'DM Mono';margin-top:13px}.error-box{display:flex;flex-direction:column;justify-content:center}.error-box strong{font:600 19px 'DM Mono';margin:4px 0 9px}.good{color:var(--green);font-size:10px}.notes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.notes-grid strong{color:#dce9f6;font-size:12px}.notes-grid p{color:var(--muted);font-size:11px;line-height:1.6;margin:6px 0 0}.notes .footnote{border-top:1px solid var(--line);padding-top:12px}footer{max-width:1440px;margin:auto;padding:0 34px 25px;color:#8093aa;font-size:10px;display:flex;justify-content:space-between}
@media(max-width:850px){main{padding:18px 14px 35px}.topbar{padding:22px 15px;align-items:flex-start}.top-badge{display:none}.intro{align-items:flex-start;flex-direction:column}.live-readout{width:100%;justify-content:space-around}.parameter-grid{grid-template-columns:1fr 1fr}.dashboard{grid-template-columns:1fr}.viz-panel.full{grid-column:auto}.inverse-grid{grid-template-columns:1fr}.notes-grid{grid-template-columns:1fr;gap:12px}.speed-control{margin-left:0}.chart{height:260px}footer{padding:0 15px 20px;gap:10px;flex-direction:column}}
@media(max-width:480px){.topbar h1{font-size:21px}.brand-mark{width:45px;height:45px}.parameter-grid{grid-template-columns:1fr}.metrics strong{font-size:11px}.panel{padding:15px}.checks{gap:12px}.button{padding:9px 10px}}

.chart-tools{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:7px 0 2px}.view-switch{display:inline-flex;gap:4px;padding:4px;background:#0c1726;border:1px solid #263a50;border-radius:9px}.view-btn{border:0;border-radius:6px;padding:7px 10px;background:transparent;color:#9aabc0;font:600 10px Manrope;cursor:pointer}.view-btn.active{background:#24465a;color:#8de6df}.trace-option{display:flex;align-items:center;gap:6px;color:#aebed0;font-size:10px;cursor:pointer}.trace-option input{accent-color:var(--cyan)}

